# HZ-EVM-RK3588 BSP toolchain override
# Vendor SDK uses aarch64-buildroot-linux-gnu-, not the Armbian default aarch64-linux-gnu-

declare -g KERNEL_COMPILER="aarch64-buildroot-linux-gnu-"
declare -g UBOOT_COMPILER="aarch64-buildroot-linux-gnu-"
declare -g ATF_COMPILER="aarch64-buildroot-linux-gnu-"

# Point Armbian at OUR vendor BSP sources instead of the default
# Armbian linux-rockchip / Radxa U-Boot repositories.
# Branch layout in iorca/BSP-Armbian-HZHY:
#   kernel  -> vendor kernel 6.1.99
#   u-boot  -> vendor U-Boot 2017.09 (HZ_EVM_RK3588_v1.0.0_20250515)
#   rkbin   -> Rockchip DDR/BL31 blobs
KERNELSOURCE='https://github.com/iorca/BSP-Armbian-HZHY.git'
KERNELBRANCH='branch:kernel'
BOOTSOURCE='https://github.com/iorca/BSP-Armbian-HZHY.git'
BOOTBRANCH='branch:u-boot'

# Do NOT apply Armbian/Radxa patches to the vendor trees.
# The rk35xx family defaults are KERNELPATCHDIR='rk35xx-vendor-6.1' (written for
# armbian/linux-rockchip) and BOOTPATCHDIR='legacy/u-boot-radxa-rk35xx' (written
# for Radxa U-Boot). Neither applies to this vendor kernel 6.1.99 / U-Boot
# 2017.09 fork — they would conflict. Set to empty so the patch dirs are skipped.
KERNELPATCHDIR=''
BOOTPATCHDIR=''

# Toolchain is downloaded from GitHub Release in CI, extracted to ./toolchain
# Armbian's Docker build mounts the workspace, while /opt/toolchain is not
# automatically visible inside its container.
if [[ -d "${SRC}/toolchain/HZ-EVM-RK3588-Linux-GCC/bin" ]]; then
    export PATH="${SRC}/toolchain/HZ-EVM-RK3588-Linux-GCC/bin:${PATH}"
fi
