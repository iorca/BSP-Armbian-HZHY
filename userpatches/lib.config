# HZ-EVM-RK3588 BSP toolchain override
# Vendor SDK uses aarch64-buildroot-linux-gnu-, not the Armbian default aarch64-linux-gnu-

declare -g KERNEL_COMPILER="aarch64-buildroot-linux-gnu-"
declare -g UBOOT_COMPILER="aarch64-buildroot-linux-gnu-"
declare -g ATF_COMPILER="aarch64-buildroot-linux-gnu-"

# Toolchain is downloaded from GitHub Release in CI, extracted to /opt/toolchain
# This path must match the workflow YAML extraction destination
if [[ -d "/opt/toolchain/HZ-EVM-RK3588-Linux-GCC/bin" ]]; then
    export PATH="/opt/toolchain/HZ-EVM-RK3588-Linux-GCC/bin:${PATH}"
fi
